{
    "name": "craigsimps/laravel-pdf-testing",
    "description": "Pest and PHPUnit assertions against real PDF text, pages and rendered snapshots.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/process": "^7.2 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "3.8.6"
    },
    "autoload": {
        "psr-4": {"PdfTesting\\": "src/"},
        "files": ["src/expectations.php"]
    },
    "config": {"allow-plugins": {"pestphp/pest-plugin": true}, "sort-packages": true, "platform": {"php": "8.3.0"}},
    "scripts": {
        "test": "pest",
        "lint": ["find src tests -name '*.php' -print0 | xargs -0 -n1 php -l", "node --check bin/pdf.mjs", "node --check bin/snapshot.mjs", "node --check tests/fixtures/generate.mjs"]
    }
}

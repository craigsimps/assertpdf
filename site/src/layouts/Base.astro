---
// Document shell for every page. Tokens come first so site.css can rely on them.
import '../../../docs/brand/tokens.css';
import '../styles/fonts.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Path of this page, used for the canonical and Open Graph URLs. */
  path?: string;
  /** Set on pages that search engines should not index (the 404 page). */
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og/social-preview.png', Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical.href}>}
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#0F171F">
<meta property="og:type" content="website">
<meta property="og:site_name" content="AssertPDF">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical.href}>
<meta property="og:image" content={ogImage.href}>
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta property="og:image:alt" content="AssertPDF. Test the PDF your Laravel app generates. PDF text, page counts and snapshots for Pest and PHPUnit. Free, MIT licensed.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage.href}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href="/fonts/ibm-plex-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
<slot />
</body>
</html>

<Base title="Page not found: Laravel PDF Testing" description="There is no page at this address." path="/404" noindex>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header on-ground">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Laravel PDF Testing, home">
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
        <path class="page" d="M8 3h12l6 6v18a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke-width="2" stroke-linejoin="round"/>
        <path class="page" d="M20 3v6h6" stroke-width="2" stroke-linejoin="round"/>
        <path class="page" d="M11 14h7M11 18h10" stroke-width="2" stroke-linecap="round"/>
        <path class="tick" d="M11 24l3 3 6-6" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Laravel PDF Testing
